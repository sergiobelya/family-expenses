<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Family\Domain\Entity\Invitation" table="invitations">
        <indexes>
            <index name="idx_invitations_family_id" columns="family_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_invitations_token_hash" columns="token_hash"/>
        </unique-constraints>

        <id name="id" type="uuid"/>
        <field name="familyId" column="family_id" type="uuid"/>
        <field name="tokenHash" column="token_hash" type="string" length="64" unique="true"/>
        <field name="createdByUserId" column="created_by_user_id" type="uuid"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
        <field name="revokedAt" column="revoked_at" type="datetime_immutable" nullable="true"/>
        <field name="maxUses" column="max_uses" type="integer" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>

</doctrine-mapping>
