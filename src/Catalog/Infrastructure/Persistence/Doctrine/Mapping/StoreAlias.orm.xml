<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Catalog\Domain\Entity\StoreAlias" table="store_aliases">
        <indexes>
            <index name="idx_store_aliases_family_store" columns="family_id,store_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_store_aliases_family_dedupe" columns="family_id,alias_dedupe_key"/>
        </unique-constraints>
        <id name="id" type="store_alias_id"/>
        <field name="familyId" column="family_id" type="family_id"/>
        <many-to-one field="store" target-entity="App\Catalog\Domain\Entity\Store" inversed-by="aliases">
            <join-column name="store_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <field name="alias" type="store_name" length="100"/>
        <field name="aliasDedupeKey" column="alias_dedupe_key" type="string" length="500"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
